#!/bin/bash
# overdrive — the whole local AI setup as one versioned tool.
#
# The umbrella is a LOCAL git repo at ~/.claude (no remote, never pushed). It
# tracks the loose config directly (whitelist in ~/.claude/.gitignore) and pins
# every component that has its own repo/package by SHA/version in overdrive.lock.
#
#   ~/.claude/VERSION                                         semver of the setup
#   ~/.claude/overdrive.lock                                  component pins (generated)
#   ~/.claude/.local_ai_setup_logs/overdrive_<VER>_logs.txt   one log per version
#
# Usage:
#   overdrive                    status: version, uncommitted changes, lock drift (read-only)
#   overdrive version            print the version
#   overdrive log "<msg>"        append a line to the current version's log
#   overdrive snapshot ["<msg>"] regenerate the lock, commit if anything changed
#   overdrive snapshot --if-drift ["<msg>"]   only when the lock drifted; commits ONLY the
#                                lock + log (never your other uncommitted edits)
#   overdrive bump patch|minor|major "<msg>"   new version + new log + commit + tag
#   overdrive history            versions (tags) with their messages
#   overdrive changelog [N]      the last N versions (default 5) with their log lines
#   overdrive trace [<session-id>|--last] [--json]   per-tool calls, wall time, ≈ctx tokens
#                                and model tokens of one Claude session, read after the fact
#   overdrive catalog [--json]   every tool: glyph, live version, kind, purpose, commands
#   overdrive limits             quota, rag-verify caps, dual-review caps, MCP timeout, known limits
#   overdrive session [show] [--level WARN|CRITICAL]   this session's log (see SESSION-LOG.md)
#   overdrive session path       where this session's log lives
#   overdrive session list       every session log on disk (crashed sessions leave theirs)
#   overdrive session rm [--all] delete this session's log (/remove-log); --all = every one
#
# Art (FLAIR.md) only on a TTY; OVERDRIVE_FLAIR=0 or a pipe turns it off, NO_COLOR drops colour.
set -euo pipefail

NAME="overdrive"
ROOT="$HOME/.claude"
VERSION_FILE="$ROOT/VERSION"
LOCK="$ROOT/overdrive.lock"
LOG_DIR="$ROOT/.local_ai_setup_logs"
MCP_DIR="$HOME/Desktop/Workspace/mcp-servers"
HERE="$(dirname "$(readlink -f "$0")")"

SLOG_TOOL="$NAME"
# shellcheck source=sessionlog.sh
. "$HERE/sessionlog.sh"
FLAIR_TOOL="$NAME" FLAIR_GLYPH="⏣"
# shellcheck source=flair.sh
. "$HERE/flair.sh"

g() { git -C "$ROOT" "$@"; }
ver() { tr -d '[:space:]' < "$VERSION_FILE"; }
SLOG_VERSION=$(ver 2>/dev/null || echo 0)
log_file() { echo "$LOG_DIR/${NAME}_$(ver)_logs.txt"; }
stamp() { date '+%Y-%m-%d %H:%M:%S'; }

# colour helper for our own lines: c <palette name> <text> (plain when no flair / NO_COLOR)
c() {
  local rgb
  case "$1" in mag) rgb="238;79;255" ;; cyan) rgb="0;255;247" ;; green) rgb="5;255;161" ;;
    yellow) rgb="240;255;25" ;; red) rgb="255;42;109" ;; *) rgb="90;80;130" ;; esac
  shift
  if flair_on && [ -z "${NO_COLOR:-}" ]; then printf '\033[38;2;%sm%s\033[0m' "$rgb" "$*"; else printf '%s' "$*"; fi
}

# start/finish a flair'd command: banner on TTY, `done <cmd> in N ms` session-log line always
T0=""
begin() { FLAIR_CMD="$1"; T0=$(flair_now_ms); flair_banner "$1"; }
finish() { flair_done "${1:-0}" "$T0"; }

log() { # $* = message
  mkdir -p "$LOG_DIR"
  printf '%s  %s\n' "$(stamp)" "$*" >> "$(log_file)"
}

# One line per component: name, kind, pin. Sorted, so the lock diffs cleanly.
# $1 = the file to write. Only snapshot/bump write $LOCK; status writes a temp file.
# hooks/overdrive-drift.sh re-derives the git/pkg rows (and the four bin rows) cheaply
# in the same order — keep the two in step when this changes.
gen_lock() {
  local out="$1"
  {
    echo "# overdrive.lock — generated by \`overdrive snapshot\`, do not edit"
    echo "# <component>  <kind>  <pin>"
    local d name sha dirty v
    for d in "$ROOT/tools/rig" "$ROOT/tools/dual-review" "$ROOT/tools/rag-vault" \
             "$MCP_DIR" "$MCP_DIR"/vlm-* "$HOME/Desktop/RAG"; do
      [ -d "$d/.git" ] || continue
      name="${d/#$HOME/~}"
      sha=$(git -C "$d" rev-parse --short=10 HEAD 2>/dev/null || echo "no-commits")
      dirty=""; [ -n "$(git -C "$d" status --porcelain 2>/dev/null | head -1)" ] && dirty="+dirty"
      printf '%-48s git   %s%s\n' "$name" "$sha" "$dirty"
    done
    for d in "$MCP_DIR"/vlm-*; do
      v=""
      if [ -f "$d/pyproject.toml" ]; then
        v=$(sed -n 's/^version *= *"\(.*\)"/\1/p' "$d/pyproject.toml" | head -1)
      elif [ -f "$d/node_modules/vlm-code-context-mcp/package.json" ]; then
        v=$(jq -r .version "$d/node_modules/vlm-code-context-mcp/package.json")
      fi
      [ -n "$v" ] && printf '%-48s pkg   %s\n' "$(basename "$d")" "$v"
    done
    local bin
    for bin in tix dual-review relpilot rig ollama claude; do
      command -v "$bin" >/dev/null 2>&1 || continue
      v=$("$bin" --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1 || true)
      printf '%-48s bin   %s\n' "$bin" "${v:-present}"
    done
    if command -v ollama >/dev/null 2>&1; then
      ollama list 2>/dev/null | awk 'NR>1 {printf "%-48s model %s\n", "ollama:" $1, $2}'
    fi
  } > "$out.tmp.$$"
  mv -f "$out.tmp.$$" "$out"
}

commit() { # $1 = message
  g add -A
  if g diff --cached --quiet; then
    echo "$NAME $(ver): nothing changed"
    return 1
  fi
  g commit -q -m "$1"
  echo "$NAME $(ver): committed $(g rev-parse --short HEAD) — $1"
  slog INFO "committed $(g rev-parse --short HEAD): $1"
}

# prints the drift between the committed lock and a fresh one; returns 1 when there is drift
lock_drift() { # $1 = fresh lock file
  local committed; committed=$(g show HEAD:overdrive.lock 2>/dev/null || true)
  [ "$committed" = "$(cat "$1")" ] && return 0
  diff <(printf '%s\n' "$committed") "$1" | grep -E '^[<>] [^#]' | while IFS= read -r l; do
    case "$l" in "<"*) printf '  %s\n' "$(c red "- ${l#< }")" ;; *) printf '  %s\n' "$(c green "+ ${l#> }")" ;; esac
  done
  return 1
}

cmd_status() {
  begin status
  printf '%s %s  %s\n' "$(c cyan "$(flair_on && printf '⏣ ')$NAME")" "$(c green "$(ver)")" "$(c dim "($(g rev-parse --short HEAD 2>/dev/null || echo 'no commits'))")"
  local changes; changes=$(g status --porcelain | wc -l | tr -d ' ')
  echo "uncommitted files: $changes"
  # read-only: generate into a temp file, never touch overdrive.lock
  local tmp; tmp=$(mktemp "${TMPDIR:-/tmp}/overdrive.lock.XXXXXX")
  gen_lock "$tmp"
  local out rc=0; out=$(lock_drift "$tmp") || rc=1
  rm -f "$tmp"
  if [ "$rc" = 1 ]; then
    c yellow "component drift since last snapshot:"; echo
    printf '%s\n' "$out"
    c dim "→ overdrive snapshot \"<what>\" records it"; echo
  else
    c green "lock: no drift"; echo
  fi
  echo "log: ${LOG_DIR/#$HOME/~}/$(basename "$(log_file)")"
  finish 0
}

cmd_snapshot() { # [--if-drift] [message]; the log line rides in the same commit
  local if_drift=0
  [ "${1:-}" = --if-drift ] && { if_drift=1; shift; }
  local msg="${*:-snapshot}"
  begin snapshot
  if [ "$if_drift" = 1 ]; then
    # one snapshot at a time (two sessions starting together both see the drift)
    local lk="$LOG_DIR/.snapshot.lock"
    mkdir -p "$LOG_DIR"
    if ! mkdir "$lk" 2>/dev/null; then
      if [ -n "$(find "$lk" -maxdepth 0 -mmin +10 2>/dev/null)" ]; then rmdir "$lk" 2>/dev/null; mkdir "$lk" 2>/dev/null || true
      else slog INFO "snapshot --if-drift: another snapshot is running"; echo "another snapshot is running"; finish 0; return 0; fi
    fi
    # shellcheck disable=SC2064
    trap "rmdir '$lk' 2>/dev/null || true" EXIT
    local tmp; tmp=$(mktemp "${TMPDIR:-/tmp}/overdrive.lock.XXXXXX")
    gen_lock "$tmp"
    local out rc=0; out=$(lock_drift "$tmp") || rc=1
    if [ "$rc" = 0 ]; then
      rm -f "$tmp"; echo "$NAME $(ver): no drift"; slog INFO "snapshot --if-drift: no drift"; finish 0; return 0
    fi
    printf '%s\n' "$out"
    mv -f "$tmp" "$LOCK"
    log "snapshot: $msg"
    # commit ONLY the lock and the log — a background auto-snapshot must never sweep up
    # whatever else is half-edited in ~/.claude
    local lf; lf=$(log_file)
    g add -- overdrive.lock "${lf#"$ROOT"/}"
    if g commit -q -m "$NAME $(ver): $msg" -- overdrive.lock "${lf#"$ROOT"/}"; then
      echo "$NAME $(ver): committed $(g rev-parse --short HEAD) — $msg"
      slog INFO "snapshot --if-drift: committed $(g rev-parse --short HEAD): $(printf '%s' "$out" | sed 's/\x1b\[[0-9;]*m//g' | tr -s ' ' | tr '\n' ';')"
    else
      slog WARN "snapshot --if-drift: git commit failed"; finish 1; return 1
    fi
    finish 0; return 0
  fi
  gen_lock "$LOCK"
  g add -A
  if g diff --cached --quiet; then echo "$NAME $(ver): nothing changed"; finish 0; return 0; fi
  log "snapshot: $msg"
  commit "$NAME $(ver): $msg"
  finish 0
}

next_version() { # $1 = current, $2 = patch|minor|major
  local major minor patch
  IFS=. read -r major minor patch <<< "$1"
  case "$2" in
    major) echo "$((major + 1)).0.0" ;;
    minor) echo "$major.$((minor + 1)).0" ;;
    patch) echo "$major.$minor.$((patch + 1))" ;;
    *) echo "bump: expected patch|minor|major, got '$2'" >&2; exit 2 ;;
  esac
}

cmd_bump() {
  local kind="${1:-}" msg="${2:-}"
  [ -n "$msg" ] || { echo "usage: $NAME bump patch|minor|major \"<what changed>\"" >&2; exit 2; }
  local old new
  old=$(ver); new=$(next_version "$old" "$kind")
  begin "bump $old → $new"
  log "bump $old -> $new: $msg (log continues in ${NAME}_${new}_logs.txt)"
  echo "$new" > "$VERSION_FILE"
  log "=== $NAME $new — $msg (from $old)"
  gen_lock "$LOCK"
  commit "$NAME $new: $msg" || true
  g tag -a "v$new" -m "$msg"
  SLOG_VERSION="$new" slog INFO "bumped $old -> $new: $msg"
  echo "tagged $(c green "v$new")"
  finish 0
}

cmd_changelog() { # [N] versions, newest first, with their log lines
  local n="${1:-5}"
  case "$n" in ''|*[!0-9]*) echo "usage: $NAME changelog [N]" >&2; exit 2 ;; esac
  begin changelog
  local tag v f date subj first=1
  while IFS= read -r tag; do
    [ -n "$tag" ] || continue
    v="${tag#v}"
    date=$(g for-each-ref --format='%(taggerdate:short)%(committerdate:short)' "refs/tags/$tag" 2>/dev/null | cut -c1-10)
    subj=$(g for-each-ref --format='%(contents:subject)' "refs/tags/$tag" 2>/dev/null)
    [ "$first" = 1 ] || flair_div
    first=0
    printf '%s %s  %s\n' "$(c mag "$(flair_on && printf '▓▒░ ')$tag")" "$(c dim "$date")" "$subj"
    f="$LOG_DIR/${NAME}_${v}_logs.txt"
    if [ -f "$f" ]; then
      while IFS= read -r line; do printf '  %s\n' "$(c dim "${line:0:19}")${line:19}"; done < "$f"
    else
      echo "  $(c dim "(no log file)")"
    fi
  done < <(g tag -l 'v*' --sort=-v:refname | head -n "$n")
  finish 0
}

# ---------- trace ----------
newest_transcript() {
  local f
  # shellcheck disable=SC2012  # names are UUIDs; ls -t is the cheap mtime sort
  f=$(command ls -t "$ROOT"/projects/*/*.jsonl 2>/dev/null | head -1 || true)
  printf '%s' "$f"
}

cmd_trace() {
  local id="" json=0 a
  for a in "$@"; do
    case "$a" in
      --json) json=1 ;;
      --last) id="--last" ;;
      -h|--help) echo "usage: $NAME trace [<session-id>|--last] [--json]"; return 0 ;;
      -*) echo "$NAME trace: unknown option $a" >&2; exit 2 ;;
      *) id="$a" ;;
    esac
  done
  [ -n "$id" ] || id="${CLAUDE_CODE_SESSION_ID:---last}"
  local f=""
  if [ "$id" = --last ]; then
    f=$(newest_transcript)
  else
    id="${id//[^A-Za-z0-9._-]/_}"
    local m
    for m in "$ROOT"/projects/*/"$id"*.jsonl; do [ -f "$m" ] && { f="$m"; break; }; done
  fi
  [ -n "$f" ] && [ -f "$f" ] || { echo "$NAME trace: no transcript found for '${id}'" >&2; exit 1; }
  local sid; sid=$(basename "$f" .jsonl)
  local slog_file; slog_file="$(dirname "$(CLAUDE_CODE_SESSION_ID="$sid" slog_path)")/$sid.log"
  local args=(--transcript "$f" --slog "$slog_file")
  if [ "$json" = 1 ]; then
    FLAIR_CMD=trace T0=$(flair_now_ms)
    python3 -I "$HERE/trace.py" "${args[@]}" --json
    flair_done 0 "$T0" >/dev/null
    return 0
  fi
  begin "trace ${sid:0:8}"
  if flair_on; then args+=(--art); [ -n "${NO_COLOR:-}" ] || args+=(--color); fi
  python3 -I "$HERE/trace.py" "${args[@]}"
  finish 0
}

# ---------- catalog ----------
expand() { printf '%s' "${1/#\~/$HOME}"; }

src_version() { # $1 = version-source (see catalog.tsv header) → version or "—"
  local s="$1" p v=""
  case "$s" in
    overdrive) v="$(ver) (setup)" ;;
    file:*) p=$(expand "${s#file:}"); [ -f "$p" ] && v=$(head -1 "$p" | tr -d '[:space:]') ;;
    var:*)
      local rest="${s#var:}" var; var="${rest##*:}"; p=$(expand "${rest%:*}")
      [ -f "$p" ] && v=$(grep -m1 -oE "(^|[ ;])${var}=\"?[0-9][^\" ;]*" "$p" | sed -E "s/.*${var}=\"?//") ;;
    pyproject:*) p=$(expand "${s#pyproject:}")/pyproject.toml
      [ -f "$p" ] && v=$(sed -n 's/^version *= *"\(.*\)"/\1/p' "$p" | head -1) ;;
    npm:*) p=$(expand "${s#npm:}")
      [ -f "$p" ] && v=$(sed -nE 's/^ *"version": *"([^"]*)".*/\1/p' "$p" | head -1) ;;
    bin:*) p="${s#bin:}"
      command -v "$p" >/dev/null 2>&1 && v=$("$p" --version 2>/dev/null | head -1 | grep -oE '[0-9]+\.[0-9]+(\.[0-9]+)?' | head -1 || true) ;;
  esac
  printf '%s' "${v:-—}"
}

cmd_catalog() {
  local json=0; [ "${1:-}" = --json ] && json=1
  local cat="$HERE/catalog.tsv" name glyph kind src purpose cmds v
  [ -f "$cat" ] || { echo "$NAME: $cat missing" >&2; exit 1; }
  if [ "$json" = 1 ]; then
    while IFS=$'\t' read -r name glyph kind src purpose cmds; do
      case "$name" in ''|\#*) continue ;; esac
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$name" "$glyph" "$kind" "$(src_version "$src")" "$purpose" "$cmds"
    done < "$cat" | python3 -I -c '
import json, sys
k = ("name", "glyph", "kind", "version", "purpose", "commands")
print(json.dumps([dict(zip(k, l.rstrip("\n").split("\t"))) for l in sys.stdin], ensure_ascii=False, indent=1))'
    return 0
  fi
  begin catalog
  while IFS=$'\t' read -r name glyph kind src purpose cmds; do
    case "$name" in ''|\#*) continue ;; esac
    v=$(src_version "$src")
    if flair_on; then
      printf '%s %-14s %-16s %-11s %s\n' "$(c mag "$glyph")" "$(c cyan "$name")" "$(c green "$v")" "$(c dim "$kind")" "$purpose"
      printf '    %s\n' "$(c dim "▸ $cmds")"
    else
      printf '%s\t%s\t%s\t%s\t%s\t%s\n' "$glyph" "$name" "$v" "$kind" "$purpose" "$cmds"
    fi
  done < "$cat"
  finish 0
}

# ---------- limits ----------
dr_cfg() { # $1 var, $2 default — same precedence as dual-review's cfg(): env > keys.env > default
  local val="${!1:-}" kf="$HOME/.config/rig/keys.env"
  # only non-secret tuning names are read here; a key value is never looked at
  [ -z "$val" ] && [ -f "$kf" ] && val=$(sed -nE "s/^(export +)?$1=[\"']?([^\"']*)[\"']?$/\\2/p" "$kf" | tail -1)
  printf '%s' "${val:-$2}"
}
dr_default() { # $1 var → the default in dual-review.sh's `cfg VAR default`
  sed -nE "s/.*\\(cfg $1 \"?([^\")]*)\"?\\).*/\\1/p" "$ROOT/tools/dual-review/dual-review.sh" 2>/dev/null | head -1
}
section() { flair_on && { flair_div; printf '%s\n' "$(c mag "▓▒░ $1")"; } || printf '\n== %s\n' "$1"; }

cmd_limits() {
  begin limits
  section "claude quota (rig quota)"
  if command -v rig >/dev/null 2>&1; then
    local q rc=0; q=$(rig quota 2>&1) || rc=$?
    case "$rc" in 0) printf '  %s\n' "$(c green "$q")" ;; 1) printf '  %s  %s\n' "$(c red "$q")" "$(c dim "(exit 1: window hot — no Opus wave)")" ;;
      *) printf '  %s  %s\n' "$(c yellow "$q")" "$(c dim "(exit $rc: unknown)")" ;; esac
  else echo "  rig not installed"; fi

  section "rag-verify caps (vlm-rag-context [verify])"
  local P="$MCP_DIR/vlm-rag-context" st=""
  if [ -x "$P/.venv/bin/python" ]; then
    st=$( cd "$P" && PYTHONSAFEPATH=1 PYTHONPATH="$P/src" "$P/.venv/bin/python" -P -m rag_context.cli --db "$MCP_DIR/data/rag.db" verify status --json 2>/dev/null ) || true
  fi
  RV_STATUS="$st" python3 -I - "$P/config.toml" <<'PY' || echo "  (could not read rag-context config)"
import json, os, sys, tomllib
try:
    v = tomllib.load(open(sys.argv[1], "rb")).get("verify", {})
except OSError:
    v = {}
env = {"daily_token_cap": "RAG_VERIFY_DAILY_CAP", "weekly_token_cap": "RAG_VERIFY_WEEKLY_CAP",
       "judge_max_tokens": "RAG_VERIFY_MAX_TOKENS", "judge_timeout_seconds": "RAG_VERIFY_TIMEOUT"}
def val(k):
    e = env.get(k)
    return (os.environ[e] + " (env)") if e and os.environ.get(e) else v.get(k, "—")
try:
    s = json.loads(os.environ.get("RV_STATUS") or "{}")
except ValueError:
    s = {}
print(f"  per tick     {val('tick_max_model_calls')} model call · {val('tick_max_notes')} notes · {val('tick_max_seconds')} s  (every 2 h)")
print(f"  tokens       today {s.get('tokens_today', '?')} / {val('daily_token_cap')} · week {s.get('tokens_week', '?')} / {val('weekly_token_cap')}")
print(f"  judge        {v.get('provider', '?')} · max {val('judge_max_tokens')} tok · timeout {val('judge_timeout_seconds')} s · local-only {', '.join(v.get('local_only_prefixes', []))}")
if s:
    print(f"  state        enabled={s.get('enabled')} paused={s.get('paused')} queue_open={s.get('queue_open')}")
PY

  section "dual-review caps"
  local mx ch jobs to dsm glm
  mx=$(dr_cfg DUAL_REVIEW_MAX_CHARS "$(dr_default DUAL_REVIEW_MAX_CHARS)")
  ch=$(dr_cfg DUAL_REVIEW_CHUNK_CHARS "$(dr_default DUAL_REVIEW_CHUNK_CHARS)")
  jobs=$(dr_cfg DUAL_REVIEW_CHUNK_JOBS "$(dr_default DUAL_REVIEW_CHUNK_JOBS)")
  to=$(dr_cfg DUAL_REVIEW_TIMEOUT "$(dr_default DUAL_REVIEW_TIMEOUT)")
  dsm=$(dr_cfg DEEPSEEK_MAX_TOKENS "$(dr_default DEEPSEEK_MAX_TOKENS)")
  glm=$(dr_cfg GLM_MAX_TOKENS "$(dr_default GLM_MAX_TOKENS)")
  local parts="?"; case "$mx$ch" in *[!0-9]*|'') ;; *) [ "$ch" -gt 0 ] && parts=$(( (mx + ch - 1) / ch )) ;; esac
  echo "  max diff     $mx chars (above: cut, PASS is partial)"
  echo "  per part     $ch chars → ≤ $parts parts · $jobs parts at a time"
  echo "  per call     timeout $to s · max out deepseek $dsm / glm $glm tok"

  section "MCP"
  local mt="${MCP_TOOL_TIMEOUT:-}"
  [ -n "$mt" ] || mt=$(python3 -I -c 'import json,sys;print(json.load(open(sys.argv[1])).get("env",{}).get("MCP_TOOL_TIMEOUT",""))' "$ROOT/settings.json" 2>/dev/null || true)
  if [ -n "$mt" ]; then echo "  tool call    ${mt} ms (MCP_TOOL_TIMEOUT)"; else echo "  tool call    120 s (MCP_TOOL_TIMEOUT unset → Claude Code ceiling)"; fi

  section "known limits ($(basename "$HERE")/limits.txt)"
  local area lim why
  while IFS=$'\t' read -r area lim why; do
    case "$area" in ''|\#*) continue ;; esac
    printf '  %-13s %s  %s\n' "$(c cyan "$area")" "$lim" "$(c dim "— $why")"
  done < "$HERE/limits.txt"
  finish 0
}

cmd_session() {
  local file sub="${1:-show}"; file=$(slog_path)
  [ $# -gt 0 ] || set -- show
  local dir="${file%/*}"
  case "$sub" in
    path) echo "$file" ;;
    show|--level)
      # accepts: show | show --level X | --level X
      [ "$sub" = show ] && shift
      local min=""; [ "${1:-}" = --level ] && min="${2:-}"
      [ -f "$file" ] || { echo "no session log yet: ${file/#$HOME/~}"; return 0; }
      case "$min" in
        CRITICAL) grep -E $'\tCRITICAL\t' "$file" || true ;;
        WARN)     grep -E $'\t(WARN|CRITICAL)\t' "$file" || true ;;
        "")       cat "$file" ;;
        *) echo "--level takes WARN or CRITICAL" >&2; exit 2 ;;
      esac ;;
    list)
      [ -d "$dir" ] || { echo "no session logs"; return 0; }
      local f n w cr
      for f in "$dir"/*.log; do
        [ -e "$f" ] || { echo "no session logs"; return 0; }
        n=$(wc -l < "$f" | tr -d ' ')
        w=$(grep -c $'\tWARN\t' "$f" || true); cr=$(grep -c $'\tCRITICAL\t' "$f" || true)
        printf '%-48s %5s lines  %3s WARN  %3s CRITICAL%s\n' "$(basename "$f")" "$n" "$w" "$cr" \
          "$([ "$f" = "$file" ] && echo '  ← this session')"
      done ;;
    rm)
      if [ "${2:-}" = --all ]; then
        local count; count=$(find "$dir" -name '*.log' 2>/dev/null | wc -l | tr -d ' ')
        find "$dir" -name '*.log' -delete 2>/dev/null || true
        echo "removed $count session log(s) from ${dir/#$HOME/~}"
      elif [ -f "$file" ]; then
        rm -f "$file"; echo "removed ${file/#$HOME/~}"
      else
        echo "no session log for this session (${file/#$HOME/~})"
      fi ;;
    *) echo "usage: $NAME session [show [--level WARN|CRITICAL]|path|list|rm [--all]]" >&2; exit 2 ;;
  esac
}

case "${1:-status}" in
  status)   cmd_status ;;
  version|-v|--version) printf '%s\n' "$(ver)" ;;
  log)      shift; [ $# -gt 0 ] || { echo "usage: $NAME log \"<msg>\"" >&2; exit 2; }; log "$*"; echo "logged to $(basename "$(log_file)")" ;;
  snapshot) shift; cmd_snapshot "$@" ;;
  bump)     shift; cmd_bump "$@" ;;
  history)  g tag -l 'v*' --sort=-v:refname -n1 ;;
  changelog) shift; cmd_changelog "$@" ;;
  trace)    shift; cmd_trace "$@" ;;
  catalog)  shift; cmd_catalog "$@" ;;
  limits)   shift; cmd_limits "$@" ;;
  session)  shift; cmd_session "$@" ;;
  -h|--help|help) sed -n '2,/^set -euo/p' "$(readlink -f "$0")" | sed '$d' | sed 's/^# \{0,1\}//' ;;
  *) echo "$NAME: unknown command '$1' (try: $NAME help)" >&2; exit 2 ;;
esac
